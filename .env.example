# Opção 1: usar URL completa
# DATABASE_URL=postgresql+psycopg://usuario:senha@seu-endpoint-rds.amazonaws.com:5432/garage?sslmode=require

# Opção 2: usar variáveis separadas (a aplicação monta a URL automaticamente)
RDS_HOSTNAME=seu-endpoint-rds.amazonaws.com
RDS_PORT=5432
RDS_DB_NAME=garage
RDS_USERNAME=garage
RDS_PASSWORD=sua-senha-forte
DB_SSLMODE=require
